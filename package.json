{
  "name": "mentalcraft-plugins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./Capability/Workflow/index.ts",
  "exports": {
    ".": "./Capability/Workflow/index.ts",
    "./cli": "./Capability/Workflow/cli.ts",
    "./gateway": "./Capability/Workflow/gateway.ts",
    "./business": "./Domain/Business/operation.ts",
    "./science": "./Domain/Science/operation.ts",
    "./design": "./Domain/Design/operation.ts",
    "./content": "./Domain/Content/operation.ts",
    "./infra": "./Domain/Infra/operation.ts",
    "./company": "./Domain/Company/operation.ts",
    "./workflow": "./Capability/Workflow/operation.ts",
    "./browser": "./Tool/Browser/operation.ts",
    "./message": "./Tool/Message/operation.ts",
    "./secret": "./Tool/Secret/operation.ts"
  },
  "workspaces": [
    "Capability/*",
    "Tool/*",
    "Domain/*"
  ],
  "scripts": {
    "test": "bun test",
    "gateway": "bun ./Capability/Workflow/gateway.ts",
    "cli": "bun ./Capability/Workflow/cli.ts",
    "bench": "bun ./Capability/Workflow/cli.ts bench",
    "health": "bun ./Capability/Workflow/cli.ts health",
    "doctor": "bun ./Capability/Workflow/cli.ts doctor",
    "install-mcp": "bun ./Capability/Workflow/cli.ts install-mcp",
    "check:flywheel": "bun ./.agents/scripts/check-flywheel.ts",
    "audit:workspace": "bun ./.agents/scripts/audit-workspace.ts",
    "sync:domains": "bun ./.agents/scripts/sync-domains.ts",
    "verify": "bun ./.agents/scripts/verify-all.ts"
  },
  "devDependencies": {
    "marked": "^18.0.11"
  }
}
