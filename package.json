{
  "name": "mentalcraft-plugins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./cli": "./Capability/Workflow/cli.ts",
    "./gateway": "./gateway.ts",
    "./business": "./Pipeline/Business/index.ts",
    "./science": "./Pipeline/Science/index.ts",
    "./design": "./Pipeline/Design/index.ts",
    "./content": "./Pipeline/Content/index.ts",
    "./company": "./Pipeline/Company/index.ts",
    "./workflow": "./Capability/Workflow/index.ts",
    "./browser": "./Capability/Browser/index.ts",
    "./message": "./Capability/Message/index.ts",
    "./secret": "./Capability/Secret/index.ts",
    "./ai": "./Capability/AI/index.ts",
    "./infra": "./Capability/Infra/index.ts"
  },
  "workspaces": [
    "Capability/*",
    "Pipeline/*"
  ],
  "scripts": {
    "test": "bun test",
    "gateway": "bun ./gateway.ts",
    "cli": "bun ./Capability/Workflow/cli.ts",
    "docs": "bun ./Capability/Workflow/cli.ts docs",
    "specs": "bun ./Capability/Workflow/cli.ts export-specs",
    "bench": "bun ./Capability/Workflow/cli.ts bench",
    "health": "bun ./Capability/Workflow/cli.ts health",
    "doctor": "bun ./Capability/Workflow/cli.ts doctor",
    "install-mcp": "bun ./Capability/Workflow/cli.ts install-mcp",
    "serve:gateway": "bun ./gateway.ts",
    "serve:workflow": "bun ./Capability/Workflow/mcp-server.ts",
    "serve:business": "bun ./Pipeline/Business/mcp-server.ts",
    "serve:science": "bun ./Pipeline/Science/mcp-server.ts",
    "serve:content": "bun ./Pipeline/Content/mcp-server.ts",
    "serve:design": "bun ./Pipeline/Design/mcp-server.ts",
    "serve:company": "bun ./Pipeline/Company/mcp-server.ts",
    "serve:browser": "bun ./Capability/Browser/mcp-server.ts",
    "serve:message": "bun ./Capability/Message/mcp-server.ts",
    "serve:secret": "bun ./Capability/Secret/mcp-server.ts",
    "serve:ai": "bun ./Capability/AI/mcp-server.ts",
    "serve:infra": "bun ./Capability/Infra/mcp-server.ts",
    "sync:mcp": "bun ./.agents/scripts/sync-mcp.ts",
    "check:flywheel": "bun ./.agents/scripts/check-flywheel.ts",
    "momentum:ledger": "bun ./Capability/Workflow/cli.ts momentum ledger",
    "momentum:transmit": "bun ./Capability/Workflow/cli.ts momentum transmit",
    "audit:workspace": "bun ./.agents/scripts/audit-workspace.ts",
    "sync:domains": "bun ./.agents/scripts/sync-domains.ts",
    "verify": "bun ./.agents/scripts/verify-all.ts"
  },
  "devDependencies": {
    "marked": "^18.0.11"
  }
}
