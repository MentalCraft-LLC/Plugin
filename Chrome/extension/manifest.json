{
  "manifest_version": 3,
  "name": "Holar Browser Context",
  "description": "Runs bounded contextual browser actions in inactive tabs through a local Native Messaging bridge.",
  "version": "1.2.63",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "cookies",
    "tabs",
    "tabGroups",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Grant foreground screenshot"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "text.js",
        "long-capture.js",
        "annotation.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}